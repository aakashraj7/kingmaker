# Gemini API Key (Required for live chatbot guidance & roadmaps)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Defaults to gemini-2.5-flash if not specified)
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Alternative secondary provider)
# OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Settings (Optional: defaults to local server if not specified)
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=kingmaker
