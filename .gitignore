node_modules/
frontend/node_modules/

# Production builds
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/

# Python cache and execution outputs
__pycache__/
backend/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
